---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../utils/path';
import { checkoutPath } from '../config/checkout';
import { externalLinkProps } from '../utils/externalLink';

const checkout = checkoutPath('ark');
const checkoutAttrs = externalLinkProps(checkout);
---

<BaseLayout
  title="Ark: Survival Ascended Hacks 404 | Page Not Found"
  description="This Ark: Survival Ascended Hacks page could not be found. Browse undetected Ark: Survival Ascended ESP, aimbot products and buy guides on cheatsark.com."
  noindex={true}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-lg px-5 text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
      <h1 class="mt-3 text-3xl font-bold uppercase md:text-4xl">Ark: Survival Ascended Hacks page not found</h1>
      <p class="mt-4 text-muted-foreground">
        That Ark: Survival Ascended Hacks URL does not exist or may have moved. Return home or shop ESP, aimbot and utility products.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
        <Button as="a" href={ROUTES.home} variant="primary">
          Back to home
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={checkout} variant="primary" {...checkoutAttrs}>Get access</Button>
        <Button as="a" href={ROUTES.products} variant="outline">Browse products</Button>
      </div>
    </div>
  </section>
</BaseLayout>
