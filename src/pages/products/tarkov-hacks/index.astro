---
import '../../../styles/product-cheat-page.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { productHub, cheatPages, productPages } from '../../../data/products';
import { t } from '../../../i18n';
import { resolvePageSeo } from '../../../config/seo';
import { getPageSeoEntry } from '../../../config/pageSeo';
import { breadcrumbSchema, itemListSchema, webPageSchema } from '../../../utils/schema';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CatalogCard from '../../../components/CatalogCard.astro';
import SeoRelatedLinks from '../../../components/SeoRelatedLinks.astro';
import { productPath, ROUTES } from '../../../utils/path';
import { cheatTierIcons, productCategoryIcons } from '../../../data/sectionIcons';
import { Button } from '@/components/starwind/button';
import { checkoutPath } from '../../../config/checkout';
import { externalLinkProps } from '../../../utils/externalLink';

const seo = resolvePageSeo('/products/tarkov-hacks/');
const seoEntry = getPageSeoEntry('/products/tarkov-hacks/');
const hubH1 = seoEntry?.h1 ?? 'Escape From Tarkov Hacks – All Available Cheats';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
];

const checkout = checkoutPath('tarkov');
const checkoutAttrs = externalLinkProps(checkout);

function cardIcon(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return cheatTierIcons[product.name] ?? 'crosshair';
  }
  return productCategoryIcons[product.category ?? ''] ?? 'package';
}

function cardLabel(product: (typeof productPages)[number]) {
  if (product.kind === 'tier') {
    return product.tier ?? product.name;
  }
  return product.category ?? 'Utility';
}

const buyLabelBySlug: Record<string, string> = {
  lite: 'Get access',
  pro: 'Get access',
  elite: 'Get access',
  'hwid-spoofer': 'Get access',
  ugc: 'Get access',
  'unlock-all': 'Get access',
  'cloud-dma': 'Get access',
};

const viewLabelBySlug: Record<string, string> = {
  lite: 'View Lite ESP listing',
  pro: 'View Pro combat listing',
  elite: 'View Elite suite listing',
  'hwid-spoofer': 'View HWID spoofer listing',
  ugc: 'View UGC recovery listing',
  'unlock-all': 'View camouflage listing',
  'cloud-dma': 'View Cloud DMA listing',
};

const utilityPages = productPages.filter((p) => p.kind === 'utility');
const cheatsCopy = t.cheats;
const utilitiesCopy = t.products;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: hubH1,
      description: seo.description,
      url: '/products/tarkov-hacks/',
    }),
    breadcrumbSchema(breadcrumbs),
    itemListSchema(
      productPages.map((product) => ({
        name: product.title,
        url: productPath(product.slug),
      })),
    ),
  ]}
>
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="products-hub__hero mt-6">
        <p class="products-hub__eyebrow">{utilitiesCopy.eyebrow}</p>
        <h1 class="text-3xl font-bold uppercase leading-tight md:text-4xl">{hubH1}</h1>
        <p class="mt-3 max-w-2xl text-lg text-muted-foreground">{productHub.description}</p>
        <div class="products-hub__actions mt-6">
          <Button as="a" href={checkout} variant="primary" size="lg" class="rounded-xl" {...checkoutAttrs}>
            Get access
          </Button>
          <Button as="a" href="/blog/lite-vs-pro/" variant="outline" size="lg" class="rounded-xl">
            Lite vs Pro guide
          </Button>
        </div>
      </header>

      <section class="products-hub__block mt-14" aria-labelledby="hub-tiers-title">
        <p class="products-hub__eyebrow">{cheatsCopy.eyebrow}</p>
        <h2 id="hub-tiers-title" class="products-hub__subtitle">{cheatsCopy.title}</h2>
        <p class="products-hub__lede">{cheatsCopy.subtitle}</p>
        <div class="products-hub__grid mt-8">
          {
            cheatPages.map((product) => (
              <CatalogCard
                class="catalog-card--carousel catalog-card--hub h-full"
                label={cardLabel(product)}
                title={product.title}
                href={productPath(product.slug)}
                buyUrl={product.buyUrl}
                features={product.features}
                more={product.more}
                icon={cardIcon(product)}
                badge={product.badge}
                variant={product.variant}
                buyLabel={buyLabelBySlug[product.slug] ?? 'Get access'}
                viewLabel={viewLabelBySlug[product.slug] ?? 'View product listing'}
                maxFeatures={5}
              />
            ))
          }
        </div>
      </section>

      <section class="products-hub__block mt-16" aria-labelledby="hub-utilities-title">
        <p class="products-hub__eyebrow">Utilities</p>
        <h2 id="hub-utilities-title" class="products-hub__subtitle">HWID, UGC, Cloud DMA &amp; Camouflage</h2>
        <p class="products-hub__lede">
          Each utility uses its own secure checkout link. Combat tiers (Lite, Pro, Elite) still share the main Escape from Tarkov product URL.
        </p>
        <div class="products-hub__grid products-hub__grid--utilities mt-8">
          {
            utilityPages.map((product) => (
              <CatalogCard
                class="catalog-card--carousel catalog-card--hub h-full"
                label={cardLabel(product)}
                title={product.title}
                href={productPath(product.slug)}
                buyUrl={product.buyUrl}
                features={product.features}
                more={product.more}
                icon={cardIcon(product)}
                badge={product.badge}
                variant="essential"
                buyLabel={buyLabelBySlug[product.slug] ?? 'Get access'}
                viewLabel={viewLabelBySlug[product.slug] ?? 'View product listing'}
                maxFeatures={5}
              />
            ))
          }
        </div>
      </section>

      <div class="mt-12 flex flex-wrap gap-3">
        <Button as="a" href={ROUTES.productsUtilities} variant="outline">
          Compare utilities
        </Button>
        <Button as="a" href="/blog/lite-vs-pro/" variant="outline">
          Lite vs Pro guide
        </Button>
      </div>

      <div class="mt-14">
        <SeoRelatedLinks />
      </div>
    </div>
  </section>
</BaseLayout>