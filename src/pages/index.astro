---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { resolvePageSeo } from '../config/seo';
import { getPageSeoEntry } from '../config/pageSeo';
import { faqAnswerPlainText, faqPageSchema, organizationSchema, webPageSchema, websiteSchema } from '../utils/schema';
import { getLandingFaqs } from '../data/faq';
const seo = resolvePageSeo('/');
const homeSeo = getPageSeoEntry('/');
const homeFaqs = getLandingFaqs();
const heroH1 = homeSeo?.h1 ?? 'Call of Duty: Black Ops 7 Hacks – ESP, Aimbot & Radar';
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    websiteSchema(),
    organizationSchema(),
    webPageSchema({
      name: heroH1,
      description: seo.description,
      url: '/',
    }),
    faqPageSchema(
      homeFaqs.map((f, i) => ({
        num: String(i + 1).padStart(2, '0'),
        q: f.q,
        a: faqAnswerPlainText(f.a, f.aHtml),
      })),
    ),
  ]}
>
  <HeroSection heroTitle={heroH1} />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
