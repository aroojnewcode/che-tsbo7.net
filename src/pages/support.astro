---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { getPageSeoEntry } from '../config/pageSeo';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactSupportSection from '../components/ContactSupportSection.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { breadcrumbSchema, faqAnswerPlainText, faqPageSchema, organizationSchema, webPageSchema } from '../utils/schema';
import { Prose } from '@/components/starwind/prose';
import SeoRelatedLinks from '../components/SeoRelatedLinks.astro';
import { getLandingFaqs, SITE_FAQ_SECTION_COPY } from '../data/faq';
import { Button } from '@/components/starwind/button';
import Icon from '../components/icons/Icon.astro';

const seo = resolvePageSeo('/support/');
const faqSeo = getPageSeoEntry('/faq/');
const supportCopy = t.legalPages.support;
const beforeYouBuyFaqs = getLandingFaqs();

const supportFaqs = [
  {
    q: 'What should I include in a Discord support ticket?',
    a: 'Your checkout order ID, Windows version, Call of Duty: Black Ops 7 session type, product tier or utility name, and a screenshot of the loader or Ricochet Anti-Cheat error. Download files only from your portal—not from DMs.',
  },
  {
    q: 'Why does the homepage status banner matter?',
    a: 'It shows whether cheat modules are online after Call of Duty: Black Ops 7 or anti-cheat patches. Do not launch while status is offline; wait for the updated loader from your portal.',
  },
  {
    q: 'Where do I get help choosing Lite or Pro?',
    a: 'Use the products hub, Lite vs Pro guide, features guide, FAQ, and buyer reviews before purchase. Open a ticket only if you still cannot match a tier to your playstyle.',
  },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    organizationSchema(),
    webPageSchema({
      name: t.support.title,
      description: t.support.subtitle,
      url: '/support/',
    }),
    breadcrumbSchema([
      { name: 'Home', path: '/' },
      { name: 'Support', path: '/support/' },
    ]),
    faqPageSchema(
      [...supportFaqs, ...beforeYouBuyFaqs].map((item, index) => ({
        num: String(index + 1).padStart(2, '0'),
        q: item.q,
        a: faqAnswerPlainText(item.a, 'aHtml' in item ? (item as { aHtml?: string }).aHtml : undefined),
      })),
    ),
  ]}
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:pt-10">
    <Breadcrumbs
      items={[
        { name: 'Home', path: '/' },
        { name: 'Support', path: '/support/' },
      ]}
    />
  </div>
  <ContactSupportSection titleId="support-page-title" showTicketTips />

  <section class="border-y border-border bg-muted/10 py-10 md:py-14" aria-labelledby="support-before-buy-title">
    <div class="mx-auto max-w-6xl px-5">
      <SectionHeader
        eyebrow={SITE_FAQ_SECTION_COPY.eyebrow}
        title={SITE_FAQ_SECTION_COPY.title}
        desc="Quick answers on checkout, tiers, Ricochet Anti-Cheat risk, and setup—before you open a Discord ticket."
        titleId="support-before-buy-title"
        headingLevel="h2"
      />
      <SiteFaqSection items={beforeYouBuyFaqs} variant="contextual" titleId="support-before-buy-list" hideSectionHeader />
    </div>
  </section>

  <section class="py-10 md:py-14" aria-labelledby="support-full-faq-title">
    <div class="mx-auto max-w-6xl px-5">
      <SectionHeader
        eyebrow="Full FAQ"
        title={faqSeo?.h1 ?? 'Black Ops 7 Cheats FAQ – Pricing, Features & Buying Questions'}
        desc="Browse every pre-purchase topic—plans, ESP, aimbot, products, setup, and safety."
        titleId="support-full-faq-title"
        headingLevel="h2"
      />
      <div class="mt-6 flex flex-wrap gap-3">
        <Button as="a" href="/faq/" variant="primary" class="rounded-xl">
          Open FAQ page
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href="/products/bo7-hacks/" variant="outline" class="rounded-xl">
          Compare Lite &amp; Pro
        </Button>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-3xl px-5 pb-16">
    <Prose class="max-w-none">
      {supportCopy.sections.map((section) => (
        <section class="mt-8">
          <h2>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
    </Prose>
    <SeoRelatedLinks />
  </div>
</BaseLayout>