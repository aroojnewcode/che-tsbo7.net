---
import { SITE_GUN_IMAGE } from '../config/site';

interface Props {
  size?: number;
  class?: string;
}

const { size = 44, class: className } = Astro.props;
---

<button
  type="button"
  class:list={['brand-gun', className].filter(Boolean)}
  data-brand-gun
  aria-expanded="false"
  aria-haspopup="dialog"
  aria-controls="brand-title-popover"
  aria-label="Black Ops 7 Cheats — home"
>
  <img
    src={SITE_GUN_IMAGE}
    alt=""
    width={size}
    height={size}
    class="brand-gun__image"
    draggable="false"
    loading="eager"
    decoding="async"
  />
</button>