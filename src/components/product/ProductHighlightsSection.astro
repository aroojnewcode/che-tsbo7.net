---
import type { ProductPage } from '../../data/products';
import SectionHeader from '../SectionHeader.astro';
import { Badge } from '@/components/starwind/badge';

interface Props {
  product: ProductPage;
}

const { product } = Astro.props;
---

<section
  class="border-b border-border bg-muted/15 py-10 md:py-12"
  aria-labelledby="product-highlights-title"
>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="Highlights"
      title={`What ${product.name} includes`}
      desc="Quick scan of modules before you read the full list below."
      titleId="product-highlights-title"
      headingLevel="h2"
    />

    <div class="mt-8 flex flex-wrap gap-2 md:gap-2.5">
      {
        product.features.map((feature) => (
          <Badge variant="outline" size="lg" class="rounded-full px-4 py-2 text-sm font-medium leading-snug">
            {feature}
          </Badge>
        ))
      }
    </div>

    {
      product.more > 0 && (
        <p class="mt-5 text-sm text-muted-foreground">
          Plus {product.more} additional options in the portal—listed in the modules section.
        </p>
      )
    }
  </div>
</section>
